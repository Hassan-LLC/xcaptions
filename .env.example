# Site URL used at build time for canonical URLs, sitemap.xml, robots.txt,
# llms.txt and structured data. Set this to your real domain.
# Do not add a trailing slash. You may include a subfolder, e.g.
# SITE_URL=https://example.com/my-app
SITE_URL=https://example.com

# Optional identity details used in structured data and the About statement.
# Leave the defaults until you fill these in.
# SITE_NAME=SubtitleStudio
# SITE_CONTACT_EMAIL=hello@example.com
# SITE_OPERATOR=Your name or company

# Local development only: mock transcription without an API key.
VITE_MOCK_TRANSCRIBE=true

# For local real-mode testing only, add GROQ_API_KEY to your untracked .env.local.
# Production uses public_html's PHP API and the private config.php instead.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty to load no analytics script at all. Copy .env.example to .env and
# replace the placeholder with your real GA4 ID (or empty it to disable).
VITE_GA_ID=G-XXXXXXXXXX
