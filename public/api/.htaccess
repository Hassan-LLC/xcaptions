Options -Indexes

# Keep the API endpoints out of search engines.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.example\.php|.*\.(json|log))$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.example\.php|.*\.(json|log))$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\. - [F,L]
</IfModule>
